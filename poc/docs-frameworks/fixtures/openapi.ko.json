{
  "openapi": "3.1.0",
  "info": {
    "title": "SCLS Docs PoC API",
    "version": "1.0.0",
    "description": "공개 행사 정보를 조회합니다. 나라와 태그로 필터링할 수 있습니다."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4310/v1",
      "description": "Local deterministic fixture (not production)"
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "행사 목록 조회"
    },
    {
      "name": "calendars",
      "description": "캘린더 피드 조회"
    }
  ],
  "paths": {
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "행사 목록 조회",
        "description": "공개 행사 정보를 조회합니다. 나라와 태그로 필터링할 수 있습니다.",
        "tags": [
          "events"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "description": "API 응답 콘텐츠의 언어입니다. 문서 화면 언어와 독립적입니다.",
            "schema": {
              "type": "string",
              "enum": [
                "ko",
                "ja",
                "en"
              ],
              "default": "ko"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "개최 국가 코드입니다. 예: JP 또는 KR.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          {
            "name": "tags",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "행사 목록 응답",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "slug",
                              "locale",
                              "title"
                            ],
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "slug": {
                                "type": "string"
                              },
                              "locale": {
                                "type": "string",
                                "enum": [
                                  "ko",
                                  "ja",
                                  "en"
                                ]
                              },
                              "title": {
                                "type": "string"
                              },
                              "countryCode": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "error": "VALIDATION_ERROR"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "error": "RATE_LIMITED"
                }
              }
            }
          }
        }
      }
    },
    "/events/{slug}": {
      "get": {
        "operationId": "getEvent",
        "summary": "행사 상세 조회",
        "description": "공개 행사 정보를 조회합니다. 나라와 태그로 필터링할 수 있습니다.",
        "tags": [
          "events"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "default": "poc-event"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "API 응답 콘텐츠의 언어입니다. 문서 화면 언어와 독립적입니다.",
            "schema": {
              "type": "string",
              "enum": [
                "ko",
                "ja",
                "en"
              ],
              "default": "ko"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "행사 상세 조회",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "id",
                        "slug",
                        "locale",
                        "title"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "slug": {
                          "type": "string"
                        },
                        "locale": {
                          "type": "string",
                          "enum": [
                            "ko",
                            "ja",
                            "en"
                          ]
                        },
                        "title": {
                          "type": "string"
                        },
                        "countryCode": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "error": "VALIDATION_ERROR"
                }
              }
            }
          },
          "404": {
            "description": "EVENT_NOT_FOUND"
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "error": "RATE_LIMITED"
                }
              }
            }
          }
        }
      }
    },
    "/calendars/custom.ics": {
      "get": {
        "operationId": "getCalendar",
        "summary": "캘린더 피드 조회",
        "description": "캘린더 구독 주소를 복사해서 Google Calendar 또는 Apple 캘린더에 추가합니다.",
        "tags": [
          "calendars"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "description": "API 응답 콘텐츠의 언어입니다. 문서 화면 언어와 독립적입니다.",
            "schema": {
              "type": "string",
              "enum": [
                "ko",
                "ja",
                "en"
              ],
              "default": "ko"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "개최 국가 코드입니다. 예: JP 또는 KR.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ICS calendar (RFC 5545)",
            "content": {
              "text/calendar": {
                "schema": {
                  "type": "string"
                },
                "example": "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nEND:VCALENDAR"
              }
            }
          },
          "400": {
            "description": "VALIDATION_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "error": "VALIDATION_ERROR"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": false,
                  "error": "RATE_LIMITED"
                }
              }
            }
          }
        }
      }
    }
  }
}
